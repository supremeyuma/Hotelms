# Coolify environment for the HotelMS cloud node (PostgreSQL service).
# Copy into Coolify's environment editor for the app service and fill in
# every <placeholder>. This file is documentation — it is not read at runtime.

# ---------------------------------------------------------------- database --
DB_CONNECTION=pgsql
DB_HOST=<coolify-internal-host>
DB_PORT=5432
DB_DATABASE=hotelms
DB_USERNAME=hotelms
DB_PASSWORD=<secret>

# --------------------------------------------------------------------- app --
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<public-host>
# APP_KEY: generate once with `php artisan key:generate --show` and paste here.
# Rotating it invalidates every session and encrypted value.
APP_KEY=<one-time-generated-key>

# --------------------------------------------------------------- logging ----
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ------------------------------------------- database-backed infrastructure -
# The cloud runs sessions, cache, and the queue on the same Postgres service;
# no Redis is required for the initial deployment.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------- sync (Phase 4R/8) --
# The cloud is a peer that terminals connect to; it never dials out. SYNC_PEERS
# stays empty: SyncWorker iterates sync.peers, so an empty list means the cloud
# never initiates a push cycle (rationale: ruling R6, Option A).
SYNC_ENABLED=true
SYNC_NODE_TYPE=cloud
# STABILITY RULE: SYNC_NODE_ID is a ULID minted ONCE (e.g. `php artisan tinker
# --execute="echo (string) Str::ulid();"`) and stored as a Coolify environment
# variable. Never regenerate or let code generate it for the cloud role: a new
# id makes every terminal treat the cloud as a brand-new node and re-push its
# entire change log. See config/sync.php (env-only) and .env.example.
SYNC_NODE_ID=<stable-ulid>
SYNC_PEERS=
SYNC_BATCH_SIZE=500
SYNC_REQUEST_TIMEOUT=30
# SYNC_CREDENTIAL: the shared secret terminals present to the cloud. Mint once
# (`bin2hex(random_bytes(32))`) and configure the same value on every terminal.
SYNC_CREDENTIAL=<one-time-generated-secret>

# --------------------------------------------------------------------- mail --
# Default is log; configure a real mailer before enabling guest notifications.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
