{
  "name": "desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "stage": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/stage-app.ps1",
    "build:app": "npm run build && npm run stage",
    "preview": "vite preview",
    "tauri": "tauri",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:fast": "wdio run e2e/wdio.browser.conf.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.6",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/tauri-service": "^1.5.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
