{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MooreLife",
  "version": "0.1.0",
  "identifier": "com.moorelife.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MooreLife",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../resources/app": "app",
      "../../resources/bin/x86_64-pc-windows-msvc": "runtime",
      "../../resources/postgres-runtime/x86_64-pc-windows-msvc/pgsql": "postgres",
      "../../resources/runtime/php.ini": "runtime/php.ini"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
