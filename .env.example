APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# ============================================================================
# PAYMENT GATEWAY CONFIGURATION - Multi-Provider Support
# ============================================================================

# Flutterwave Configuration
PAYMENT_FLUTTERWAVE_ENABLED=true
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_SECRET_HASH=your_flutterwave_secret_hash_here

# Paystack Configuration
PAYMENT_PAYSTACK_ENABLED=true
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# Default Payment Provider (flutterwave or paystack)
PAYMENT_DEFAULT_PROVIDER=flutterwave

# Payment Configuration
PAYMENT_CURRENCY=NGN
PAYMENT_TIMEOUT_SECONDS=30
PAYMENT_TRANSACTION_FEE_PERCENT=1.5

# ============================================================================
# DESKTOP / LAN / OFFLINE SYNCHRONIZATION
# ============================================================================
# Off by default: an unconfigured deployment behaves exactly as it did before
# sync existed. SYNC_NODE_ID is a ULID minted at first setup and must stay
# stable thereafter, because changing it orphans every row this node wrote.
# SYNC_NODE_TYPE is one of cloud, lan_server, terminal.
#
# SYNC_PEERS is JSON keyed by peer node id, e.g.
#   SYNC_PEERS={"node-b":{"base_url":"http://10.0.0.2:8000"}}
# A bare comma-separated list of URLs is still accepted for older deployments.
# SYNC_CREDENTIAL is the secret this node presents to every peer; peers store
# only its SHA-256 hash. It is issued when the node registers, so it is empty
# until then.
#
# The desktop shell reads FRANKENPHP_PORT (the port the bundled runtime binds)
# and, for the staff-client role only, LAN_SERVER_URL (the discovered server it
# opens a window at). Laravel itself does not read either.

SYNC_ENABLED=false
SYNC_NODE_ID=
SYNC_NODE_TYPE=terminal
SYNC_PROPERTY_ID=
SYNC_CREDENTIAL=
SYNC_PEERS=
SYNC_BATCH_SIZE=500
SYNC_REQUEST_TIMEOUT=30

FRANKENPHP_PORT=8000
# LAN_SERVER_URL=http://10.0.0.2:8000

# -----------------------------------------------------------------------------
# Licensing (central licence server only)
# -----------------------------------------------------------------------------
# Licences are sold per property and activated against one server. The desktop
# app verifies the signed licence offline with a public key baked into it; only
# the central licence server holds the private half.
#
# LICENCE_PRIVATE_KEY is the base64-encoded PEM of the RSA signing key. Setting
# it on a customer's server would let that server mint licences, so it must be
# absent everywhere except the deployment that issues them (activation then
# answers 503 instead of handing out a licence it cannot sign).
#
# LICENCE_TRIAL_DAYS / LICENCE_TERM_MONTHS mirror what the desktop app enforces.
LICENCE_PRIVATE_KEY=
LICENCE_TRIAL_DAYS=30
LICENCE_TERM_MONTHS=12
LICENCE_PRODUCT=MooreLife
